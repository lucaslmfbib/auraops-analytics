{
  "name": "operacoes-cosmeticos-analytics",
  "version": "1.0.0",
  "description": "Plataforma Executiva de Análise de Dados e Inteligência Operacional para Varejo de Cosméticos",
  "main": "dist/bundle.js",
  "scripts": {
    "build:js": "esbuild src/main.tsx --bundle --outfile=dist/bundle.js --loader:.tsx=tsx --loader:.ts=ts --loader:.css=empty --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/bundle.css --minify",
    "build:html": "node -e \"require('fs').copyFileSync('index.html', 'dist/index.html')\"",
    "build": "npm run build:js && npm run build:css && npm run build:html",
    "start": "python3 -m http.server 3000 --directory dist",
    "dev": "vite"
  },
  "keywords": [
    "analytics",
    "cosmetics",
    "retail",
    "dashboard",
    "abnt",
    "boticario"
  ],
  "author": "Lucas Martins",
  "license": "ISC",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.1.0",
    "recharts": "^2.15.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "esbuild-wasm": "^0.25.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.21"
  }
}
